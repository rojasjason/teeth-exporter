{
  "manifest_version": 3,
  "name": "Teeth Exporter",
  "version": "1.0.0",
  "description": "Export your own teeth and gums as STL/GLB from your Invisalign ClinCheck 3D treatment plan viewer. Runs entirely in your browser; nothing is uploaded.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Teeth Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.invisalign.com/*",
    "*://*.aligntech.com/*",
    "*://*.clincheck.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.invisalign.com/*",
        "*://*.aligntech.com/*",
        "*://*.clincheck.com/*"
      ],
      "js": ["src/capture.js", "src/webgl_capture.js", "src/viewer_bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.invisalign.com/*",
        "*://*.aligntech.com/*",
        "*://*.clincheck.com/*"
      ],
      "js": [
        "lib/lzma.js",
        "lib/ctm.js",
        "lib/fflate.umd.js",
        "src/engine.js",
        "src/stage_probe.js",
        "src/all_stages.js",
        "src/controller.js",
        "src/ui_panel.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
